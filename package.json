{
  "name": "compiler-lab",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Interactive GUI for Operator Precedence Parsing and RE to DFA (direct method)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "node scripts/serve-dist.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.js test/*.test.ts",
    "check:contrast": "node scripts/check-contrast.ts",
    "audit:deps": "npm audit --audit-level=high",
    "audit:offline": "node scripts/verify.mjs",
    "verify": "npm run typecheck && npm test && npm run build && node scripts/verify.mjs"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-serif": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  },
  "overrides": {
    "postcss": "8.5.29"
  }
}
